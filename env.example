# Phase 1 needs no environment variables.
# From Phase 2 onward, copy this file to .env and fill in real values.
# NEVER commit .env. Only VITE_ variables are exposed to the browser,
# so only public values (like the Supabase anon key) may use that prefix.

# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Server-side ONLY (Supabase Edge Function secrets, never in frontend code):
# ROBLOX_CLIENT_ID=
# ROBLOX_CLIENT_SECRET=
